# ChoreMatrix Environment Configuration
#
# NON-NEGOTIABLE CLIENT SECURITY RULES:
# 1. Use ONLY the browser-safe Publishable Key in client-side code.
# 2. NEVER add, use, or expose the Supabase Secret Key or Service Role Key in client code.
# 3. If credentials are not configured, ChoreMatrix runs in local/offline mode without crashing.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_pub_your-publishable-key-here

# Application Site URL (for Auth Redirects: Email Verification, Password Reset)
# In production (e.g. Vercel), set to your stable deployment domain.
# In local development, leave empty to default to window.location.origin (e.g. http://localhost:4173),
# or set to your production URL / LAN IP when testing email links clicked on a mobile device.
VITE_PUBLIC_SITE_URL=https://chorematrix.vercel.app
