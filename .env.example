# ChoreMatrix Environment Configuration
#
# NON-NEGOTIABLE CLIENT SECURITY RULES:
# 1. Use ONLY browser-safe publishable/client-side keys in client code.
# 2. NEVER add, use, or expose Supabase Secret Key or Paddle API Key/Webhook Secret in client code.
# 3. If credentials are not configured, ChoreMatrix runs in local/offline mode without crashing.

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_pub_your-publishable-key-here

# Application Site URL (for Auth Redirects: Email Verification, Password Reset)
VITE_PUBLIC_SITE_URL=https://chorematrix.vercel.app

# ==============================================================================
# DODO PAYMENTS SUBSCRIPTION CONFIGURATION
# ==============================================================================

# Client-Safe Dodo Payments Configuration (Whitelisted for browser bundle)
# Environment: 'test_mode' or 'live_mode'
VITE_DODO_ENVIRONMENT=test_mode

# Dodo Payments Catalog Identifiers (Safe for frontend lookup)
VITE_DODO_PRO_MONTHLY_PRODUCT_ID=pdt_0NozKZ3sZ6h0vplb451YK
VITE_DODO_PRO_ANNUAL_PRODUCT_ID=pdt_0NozL7OvhpMonCSMw99Ng
VITE_DODO_PLUS_MONTHLY_PRODUCT_ID=pdt_0NozLK4XCjDSCbkADEtQL
VITE_DODO_PLUS_ANNUAL_PRODUCT_ID=pdt_0NozLba96vBrtNtGdFONX

# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Supabase Edge Functions / Vault)
# NEVER EXPOSE THESE IN CLIENT CODE OR .env FILES BUNDLED TO BROWSERS!
# ==============================================================================
# DODO_PAYMENTS_API_KEY=dodo_api_key_here
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_endpoint_secret_here
# DODO_PAYMENTS_ENVIRONMENT=test_mode
