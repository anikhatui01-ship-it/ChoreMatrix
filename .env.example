# ChoreMatrix Environment Configuration
#
# NON-NEGOTIABLE CLIENT SECURITY RULES:
# 1. Use ONLY browser-safe publishable/client-side keys in client code.
# 2. NEVER add, use, or expose Supabase Secret Key or Paddle API Key/Webhook Secret in client code.
# 3. If credentials are not configured, ChoreMatrix runs in local/offline mode without crashing.

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_pub_your-publishable-key-here

# Application Site URL (for Auth Redirects: Email Verification, Password Reset)
VITE_PUBLIC_SITE_URL=https://chorematrix.vercel.app

# ==============================================================================
# PADDLE SANDBOX SUBSCRIPTION CONFIGURATION
# ==============================================================================

# Client-Safe Paddle Configuration (Whitelisted for browser bundle)
# Environment: 'sandbox' or 'production'
VITE_PADDLE_ENVIRONMENT=sandbox

# Paddle Sandbox Client-Side Token (Created for ChoreMatrix Sandbox Checkout)
# Safe for frontend initialization via Paddle.Initialize()
VITE_PADDLE_CLIENT_TOKEN=test_your_client_token_here

# Paddle Catalog Identifiers
VITE_PADDLE_PRODUCT_ID=pro_your_product_id_here
VITE_PADDLE_TRIAL_PRICE_ID=pri_your_trial_price_id_here
VITE_PADDLE_STANDARD_PRICE_ID=pri_your_standard_price_id_here

# ==============================================================================
# SERVER-SIDE ONLY SECRETS (Supabase Edge Functions / Vault)
# NEVER EXPOSE THESE IN CLIENT CODE OR .env FILES BUNDLED TO BROWSERS!
# ==============================================================================
# PADDLE_API_KEY=pdl_sdbx_your_sandbox_api_key_here
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_endpoint_secret_here
